<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.rmannibucau</groupId>
        <artifactId>quarkus-jdbc-generic-parent</artifactId>
        <version>999-SNAPSHOT</version>
    </parent>

    <artifactId>quarkus-jdbc-generic-integration-tests</artifactId>
    <name>Quarkus JDBC Generic - Integration Tests</name>

    <properties>
        <skipITs>true</skipITs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.rmannibucau</groupId>
            <artifactId>quarkus-jdbc-generic</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- both drivers are in the classpath: the build-time configuration selects MySQL,
             the environment repoints the datasource to H2 at runtime -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <!-- runtime override of the MySQL driver and URL configured in application.properties,
                             the way a container image is repointed to another database per environment -->
                        <QUARKUS_DATASOURCE_JDBC_GENERIC_DRIVER>org.h2.Driver</QUARKUS_DATASOURCE_JDBC_GENERIC_DRIVER>
                        <QUARKUS_DATASOURCE_JDBC_URL>jdbc:h2:mem:generic-it</QUARKUS_DATASOURCE_JDBC_URL>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
