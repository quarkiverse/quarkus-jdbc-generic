<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.quarkiverse</groupId>
        <artifactId>quarkiverse-parent</artifactId>
        <version>22</version>
    </parent>

    <groupId>io.github.rmannibucau</groupId>
    <artifactId>quarkus-jdbc-generic-parent</artifactId>
    <version>999-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Quarkus JDBC Generic - Parent</name>
    <description>Connect a Quarkus Agroal datasource to any database via a JDBC driver resolved with reflection at runtime</description>
    <url>https://github.com/rmannibucau/quarkus-jdbc-generic</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>rmannibucau</id>
            <name>Romain Manni-Bucau</name>
            <url>https://github.com/rmannibucau</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git@github.com:rmannibucau/quarkus-jdbc-generic.git</connection>
        <developerConnection>scm:git:git@github.com:rmannibucau/quarkus-jdbc-generic.git</developerConnection>
        <url>https://github.com/rmannibucau/quarkus-jdbc-generic</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>runtime</module>
        <module>deployment</module>
        <module>docs</module>
        <module>integration-tests</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <quarkus.version>3.38.0</quarkus.version>
        <assertj.version>3.27.6</assertj.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <!-- the quarkiverse-parent rule requires an io.quarkiverse.* group id, not applicable
                         while the extension is hosted on github.com/rmannibucau; remove this override
                         if the project moves to the quarkiverse organization -->
                    <execution>
                        <id>validate-project-structure</id>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
